;; macOS sandbox profile for Ralph runs. The OS enforces it, not the AI.
;; Template only: safe-ralph.sh builds the real profile with make-guard.sh. HOME is passed with -D HOME=...
(version 1)
(allow default)

;; Directories listed in protected-paths.local (no read, no write) are appended by make-guard.sh.

;; Shell, git, ssh config and login items: no writing.
(deny file-write*
  (literal (string-append (param "HOME") "/.zshrc"))
  (literal (string-append (param "HOME") "/.zprofile"))
  (literal (string-append (param "HOME") "/.zshenv"))
  (literal (string-append (param "HOME") "/.bashrc"))
  (literal (string-append (param "HOME") "/.bash_profile"))
  (literal (string-append (param "HOME") "/.profile"))
  (literal (string-append (param "HOME") "/.gitconfig"))
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/Library/LaunchAgents")))

;; Operating system and installed software: no writing.
(deny file-write*
  (subpath "/System")
  (subpath "/Library")
  (subpath "/Applications")
  (subpath "/usr")
  (subpath "/etc")
  (subpath "/private/etc")
  (subpath "/opt/homebrew"))
