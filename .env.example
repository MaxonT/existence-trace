# Paid tier (pay/server.py). Copy to .env, fill in, then: set -a; . ./.env; set +a; python3 pay/server.py
# Never commit .env. Use test keys (sk_test_..., whsec_ from the Stripe CLI) until you switch to real mode.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional
PAY_PORT=8787
PAY_PRICE_LABEL=$5 / month (placeholder)
